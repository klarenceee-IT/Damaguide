<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DamaguideV1.Pages.ResultsPage"
             Title=""
             BackgroundColor="#FAF8F5"
             Shell.NavBarIsVisible="True">

    <Shell.TitleView>
        <Grid />
    </Shell.TitleView>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Label Text="Analysis Results"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1A1A1A" />

            <!-- Main Results Card (Forced Light Background) -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#E0E0E0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    
                    <Label Text="Furniture Type" FontSize="12" TextColor="#757575" />
                    <Label x:Name="FurnitureTypeLabel" FontSize="16" FontAttributes="Bold" TextColor="#212121" />

                    <Label Text="Damage Status" FontSize="12" TextColor="#757575" />
                    <Label x:Name="DamageStatusLabel" FontSize="16" FontAttributes="Bold" TextColor="#212121" />

                    <Label Text="Damage Location" FontSize="12" TextColor="#757575" />
                    <Label x:Name="DamageLocationLabel" FontSize="16" FontAttributes="Bold" TextColor="#212121" />

                    <Label Text="Damage Severity" FontSize="12" TextColor="#757575" />
                    <Label x:Name="DamageSeverityLabel" FontSize="16" FontAttributes="Bold" TextColor="#212121" />

                    <Label Text="AI Confidence" FontSize="12" TextColor="#757575" />
                    <Label x:Name="ConfidenceLabel" FontSize="16" FontAttributes="Bold" TextColor="#212121" />

                </VerticalStackLayout>
            </Border>

            <Label Text="Repair Recommendation"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#1A1A1A" />

            <!-- Recommendation Card (Forced Light Background) -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#E0E0E0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <Label x:Name="RecommendationLabel"
                       FontSize="14"
                       TextColor="#333333"
                       LineBreakMode="WordWrap" />
            </Border>

            <!-- Take Picture Again Button -->
            <Button x:Name="BackToHomeButton"
                    Text="Back to Home"
                    BackgroundColor="#F9A8D7"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Clicked="OnBackToHomeButtonClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>